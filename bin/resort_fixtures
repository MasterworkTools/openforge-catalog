#!/usr/bin/env python3
"""Resort fixture files to match the stable sorting order.

This tool reads a fixture file and rewrites it with the current sorting logic,
allowing you to commit the reordering separately from content changes.
"""

import json

import click

from openforge.data.scanner import _sort_and_clean_recursively
from openforge.data.utils import set_handler


@click.command()
@click.argument("fixture_file", type=click.Path(exists=True))
def main(fixture_file):
    """Resort FIXTURE_FILE to match stable sorting order.

    Reads the fixture file, applies current sorting logic, and outputs to stdout.
    Typical usage:

        ./bin/resort_fixtures fixtures/blueprints/sewers.json > \\
            fixtures/blueprints/sewers.json.resorted
        mv fixtures/blueprints/sewers.json.resorted \\
            fixtures/blueprints/sewers.json
    """
    # Load existing fixture
    with open(fixture_file, "r") as f:
        data = json.load(f)

    # Apply current sorting logic (same as scanner/incremental)
    # Exclude config.parts from sorting to preserve order
    sorted_data = _sort_and_clean_recursively(data, exclude_paths=["config.parts"])

    # Output with same formatting as scanner
    print(json.dumps(sorted_data, default=set_handler, indent=4, sort_keys=True))


if __name__ == "__main__":
    main()
