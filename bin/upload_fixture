#!/bin/bash

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Default values
# Use localhost by default, override with OPENFORGE_BASE_URL env var for staging/production
BASE_URL="${OPENFORGE_BASE_URL:-http://localhost:5328}"
DRY_RUN=""
VERBOSE=""

# Function to display usage
usage() {
    cat << EOF
Usage: $(basename "$0") <fixture_path> [OPTIONS]

Upload a fixture file to the OpenForge catalog API.

Arguments:
    fixture_path    Path to fixture file relative to openforge/db/fixtures/
                   Example: blueprints/dungeon_stone.json

Options:
    --dry-run      Preview changes without applying them
    --verbose      Enable verbose debug output
    --help         Display this help message

Environment:
    OPENFORGE_API_TOKEN    API token (read from .env file if present)
    OPENFORGE_BASE_URL     Base URL (default: http://localhost:5328)
                          Set to https://staging.openforge.tools for staging

Examples:
    $(basename "$0") blueprints/dungeon_stone.json
    $(basename "$0") blueprints/cave.json --dry-run --verbose
    $(basename "$0") tag_descriptions/core.yaml

EOF
    exit 1
}

# Parse arguments
if [ $# -eq 0 ]; then
    usage
fi

FIXTURE_PATH=""

while [[ $# -gt 0 ]]; do
    case $1 in
        --dry-run)
            DRY_RUN="true"
            shift
            ;;
        --verbose)
            VERBOSE="true"
            shift
            ;;
        --help)
            usage
            ;;
        *)
            if [ -z "$FIXTURE_PATH" ]; then
                FIXTURE_PATH="$1"
            else
                echo -e "${RED}Error: Multiple fixture paths specified${NC}" >&2
                usage
            fi
            shift
            ;;
    esac
done

if [ -z "$FIXTURE_PATH" ]; then
    echo -e "${RED}Error: No fixture path specified${NC}" >&2
    usage
fi

# Construct project root path (needed for .env and fixture file location)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Load .env file if it exists (look in project root)
if [ -f "$PROJECT_ROOT/.env" ]; then
    # A more robust way to export the variable, handling spaces in the value.
    # It extracts the value after the first '='.
    TOKEN_LINE=$(grep -m 1 -E '^OPENFORGE_API_TOKEN=' "$PROJECT_ROOT/.env")
    if [ -n "$TOKEN_LINE" ]; then
        # Extract value and strip surrounding quotes (single or double)
        TOKEN_VALUE="${TOKEN_LINE#*=}"
        TOKEN_VALUE="${TOKEN_VALUE#\"}"
        TOKEN_VALUE="${TOKEN_VALUE%\"}"
        TOKEN_VALUE="${TOKEN_VALUE#\'}"
        TOKEN_VALUE="${TOKEN_VALUE%\'}"
        export OPENFORGE_API_TOKEN="$TOKEN_VALUE"
    fi
fi

# Check for API token
if [ -z "${OPENFORGE_API_TOKEN:-}" ]; then
    echo -e "${RED}Error: OPENFORGE_API_TOKEN not found in .env file or environment${NC}" >&2
    exit 1
fi

# Construct full path to fixture file
FULL_FIXTURE_PATH="$PROJECT_ROOT/openforge/db/fixtures/$FIXTURE_PATH"

# Check if fixture file exists
if [ ! -f "$FULL_FIXTURE_PATH" ]; then
    echo -e "${RED}Error: Fixture file not found: $FULL_FIXTURE_PATH${NC}" >&2
    exit 1
fi

# Determine content type from file extension
CONTENT_TYPE="application/json"
if [[ "$FIXTURE_PATH" =~ \.ya?ml$ ]]; then
    CONTENT_TYPE="application/x-yaml"
fi

# Build query parameters using array for scalability
query_parts=()
if [ -n "$DRY_RUN" ]; then
    query_parts+=("dry_run=true")
fi
if [ -n "$VERBOSE" ]; then
    query_parts+=("verbose=true")
fi

QUERY_PARAMS=""
if [ ${#query_parts[@]} -gt 0 ]; then
    QUERY_PARAMS="?$(IFS='&'; echo "${query_parts[*]}")"
fi

# Construct full URL
FULL_URL="${BASE_URL}/api/admin/fixtures${QUERY_PARAMS}"

# Display request info
echo -e "${YELLOW}Uploading fixture:${NC} $FIXTURE_PATH"
if [ -n "$DRY_RUN" ]; then
    echo -e "${YELLOW}Mode:${NC} DRY RUN (preview only)"
fi
if [ -n "$VERBOSE" ]; then
    echo -e "${YELLOW}Verbose:${NC} enabled"
fi
echo ""

# Create a temporary file for the response
RESPONSE_FILE=$(mktemp)
# Ensure the temp file is cleaned up on exit
trap 'rm -f "$RESPONSE_FILE"' EXIT

# Make the request
HTTP_CODE=$(curl -w "%{http_code}" -s -o "$RESPONSE_FILE" \
    -X POST \
    -H "Authorization: Bearer ${OPENFORGE_API_TOKEN}" \
    -H "Content-Type: ${CONTENT_TYPE}" \
    --data-binary "@${FULL_FIXTURE_PATH}" \
    "${FULL_URL}")

# Check HTTP status code
if [ "$HTTP_CODE" -eq 200 ]; then
    echo -e "${GREEN}✓ Success${NC}"
    echo ""

    # Pretty print the response
    if command -v jq &> /dev/null; then
        # Use jq if available for nice formatting
        jq '.' "$RESPONSE_FILE"
    else
        # Fallback to cat
        cat "$RESPONSE_FILE"
        echo ""
    fi

    exit 0
else
    echo -e "${RED}✗ Error (HTTP $HTTP_CODE)${NC}"
    echo ""

    # Pretty print the error response
    if command -v jq &> /dev/null; then
        jq '.' "$RESPONSE_FILE"
    else
        cat "$RESPONSE_FILE"
        echo ""
    fi

    exit 1
fi
