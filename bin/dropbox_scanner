#!/usr/bin/env python

# pylint: disable=E1101,C0114,C0116
import os
import sys

import click
import jsonschema.exceptions
import yaml
from dotenv import dotenv_values

from openforge.data.incremental import (
    IncrementalScanner,
    parse_files_incremental,
    print_files_with_transformer,
    print_incremental_changes,
    print_incremental_diff,
)
from openforge.data.scanner import clean_files, find_files, parse_files, print_files


@click.command()
@click.option(
    "--path", default="/home/devon/Dropbox/projects/Hardware/objects/OpenForge/"
)
@click.option("--subset", default="")
@click.option("--md5/--no-md5", default=True, help="Calculate MD5 hash for files")
@click.option("--verbose/--no-verbose", default=False, help="Verbose output")
@click.option("--upload/--no-upload", default=False, help="Upload files to R2")
@click.option(
    "--sprites/--no-sprites", default=True, help="Generate sprite sheet thumbnails"
)
@click.option("--update", help="Update existing fixture file incrementally")
@click.option("--dry-run", is_flag=True, help="Preview changes without writing files")
@click.option(
    "--incremental", is_flag=True, help="Output only changed data by full_path"
)
@click.option(
    "--skip-schema-validation",
    is_flag=True,
    help="Skip schema validation for old fixture files",
)
def main(
    path,
    subset,
    md5,
    verbose,
    upload,
    sprites,
    update,
    dry_run,
    incremental,
    skip_schema_validation,
):
    """Run dropbox scanner with incremental or full scan mode."""
    # Load config from .env file in bin directory
    script_dir = os.path.dirname(os.path.abspath(__file__))
    env_path = os.path.join(script_dir, ".env")

    config = dotenv_values(env_path)
    if verbose and not config:
        print(
            f"Warning: No .env file found at {env_path} or is empty, "
            "using environment variables only",
            file=sys.stderr,
        )

    # Add sprites flag to config
    if sprites:
        config = dict(config) if config else {}
        config["ENABLE_SPRITE_THUMBNAILS"] = True

    if update:
        run_incremental_mode(
            path,
            subset,
            verbose,
            upload,
            update,
            dry_run,
            incremental,
            config,
            skip_schema_validation,
        )
    else:
        run_full_scan_mode(path, subset, md5, verbose, upload, config)


def run_incremental_mode(
    path,
    subset,
    verbose,
    upload,
    update,
    dry_run,
    incremental,
    config,
    skip_schema_validation,
):
    """Run incremental scanning workflow."""
    try:
        scanner = IncrementalScanner(
            update, verbose, skip_schema_validation=skip_schema_validation
        )
        subset = scanner.get_subset_path()
        if verbose:
            print(f"Detected subset path: {subset}", file=sys.stderr)
    except (
        FileNotFoundError,
        ValueError,
        jsonschema.exceptions.ValidationError,
        yaml.YAMLError,
        OSError,
    ) as e:
        print(f"Error loading fixture file: {e}", file=sys.stderr)
        sys.exit(1)

    files = find_files(path, subset)
    files = clean_files(path, files)
    files = parse_files_incremental(
        path, files, scanner, verbose, upload, config, dry_run, incremental
    )

    # Handle different output modes
    if dry_run:
        # Output diff format showing only changes
        print_incremental_diff(files, scanner, verbose)
    elif incremental:
        # Output only changed data by full_path
        print_incremental_changes(files, scanner)
    else:
        # Normal mode - output complete updated fixture with transformer applied
        print_files_with_transformer(files)


def run_full_scan_mode(path, subset, md5, verbose, upload, config):
    """Run normal scanning workflow."""
    files = find_files(path, subset)
    files = clean_files(path, files)
    files = parse_files(path, files, md5, verbose, upload, config)
    print_files(files)


if __name__ == "__main__":
    main()
