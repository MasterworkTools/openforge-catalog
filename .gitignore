# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
scratch

.env

# traffic captures — carry live credentials (JWTs, cookies); never commit.
# Raw request/response dumps of ANY extension belong in captures/ (ignored)
# or the session scratchpad, never elsewhere in the repo tree.
*.har
captures/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
__pycache__

# python
dist
*.egg-info

# vim
.*.sw?

# postgres
db-data

# yarn
yarn.lock
*.next

tmp/
.coverage
coverage.xml

.cursor

# Patreon API credentials (client secret + tokens) — never commit
.patreon
