# Database configuration
DATABASE_URL=postgresql://user:password@localhost/openforge_catalog

# API Security
API_TOKEN=your-secure-api-token-here
SECRET_KEY=your-secret-key-for-sessions-here

# OAuth Configuration
FRONTEND_URL=http://localhost:3000

# Patreon OAuth
PATREON_CLIENT_ID=your-patreon-client-id
PATREON_CLIENT_SECRET=your-patreon-client-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Patreon Tier Mapping (optional)
# Map Patreon tier titles to database enum values
# PATREON_TIER_MAP='{"Supporter": "Bronze", "Premium Supporter": "Silver", "Master Builder": "Gold", "Legendary Creator": "Platinum"}'

# Patreon Tier Amounts (optional)
# Map database enum values to minimum pledge amounts in cents
# PATREON_TIER_AMOUNTS='{"Bronze": 100, "Silver": 500, "Gold": 1000, "Platinum": 2000}'

# Cloudflare R2 Storage
CLOUDFLARE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_ACCESS_KEY_ID=your-access-key-id
CLOUDFLARE_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=openforge-models
FILE_DOMAIN=https://objects.openforge.tools

# Logging
LOG_LEVEL=INFO
