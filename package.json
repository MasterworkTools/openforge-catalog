{
  "name": "next-flask",
  "version": "0.6.8",
  "private": true,
  "scripts": {
    "flask-dev": "pip3 install -r requirements.txt && FLASK_DEBUG=1 python3 -m flask --app openforge.app.index run -p 5328 --debug",
    "next-dev": "BACKEND_API=true next dev",
    "dev": "concurrently \"pnpm run next-dev\" \"pnpm run flask-dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "type-check": "tsc --noEmit",
    "lint:all": "npm run lint && npm run type-check",
    "db-update": "bin/db_update up",
    "db-fixtures": "bin/fixtures",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "deploy:staging": "npm run build && SHA=$(git rev-parse --short HEAD) && cd out && aws s3 sync . s3://staging-openforge-catalog-website/$SHA && echo \"Deployed to staging at SHA: $SHA\"",
    "deploy:production": "npm run build && SHA=$(git rev-parse --short HEAD) && cd out && aws s3 sync . s3://production-openforge-catalog-website/$SHA && echo \"Deployed to production at SHA: $SHA\""
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.3",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@types/node": "22.19.3",
    "@uiw/react-md-editor": "^4.0.8",
    "autoprefixer": "10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "concurrently": "^9.0.0",
    "lucide-react": "^0.546.0",
    "new-github-issue-url": "^1.1.0",
    "next": "15.5.9",
    "postcss": "^8.5.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.9.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "@eslint/js": "^9.29.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.3.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.2.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "ts-jest": "^29.1.1",
    "typescript-eslint": "^8.34.1"
  }
}
